{
  "name": "@offline-rift/macro-hud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --mode hud",
    "test": "vitest run",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts index.html README.md \"../../../tests/frontend/macro-hud/*.{ts,tsx,json}\" \"../../../tests/fixtures/macro-hud/*.ts\"",
    "test:browser": "playwright test --config ../../../tests/frontend/macro-hud/playwright.config.ts",
    "package:win": "npm run build && node desktop/package.mjs win32",
    "package:linux": "npm run build && node desktop/package.mjs linux"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.51.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.3",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "4.0.18"
  }
}
