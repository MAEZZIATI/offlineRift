{
  "schema": "offline-research-protocol-v1",
  "scope": "six-policy macro coach; offline tests only",
  "coverage_diagnostics": {
    "minimum_rows": 200,
    "minimum_matches": 20,
    "target_retention": 0.9,
    "supported_cell_screen": [
      0.85,
      0.95
    ]
  },
  "decision_regret_diagnostics": {
    "tolerances": [
      0,
      0.05,
      0.1,
      0.25
    ],
    "interpretation": "learned-score gaps, not counterfactual regret"
  },
  "coach_study": {
    "scopes": [
      "TEAM",
      "TOP",
      "JUNGLE",
      "MIDDLE",
      "BOTTOM",
      "UTILITY"
    ],
    "split_seed": 42,
    "optimizer_seed": 42,
    "steps": 4000,
    "selection": "All algorithms eligible; development gate then mean clean/cold identified F1 minus 0.1 times still-feasible switching",
    "holdout": "frozen IDs before training; never select on holdout",
    "study_design": "relative-context-v2",
    "checkpoint_interval": 500,
    "early_stopping_patience": 3
  }
}
